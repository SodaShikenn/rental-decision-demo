# Reserved for future server-side integrations.
# Copy this file to .env and keep real credentials out of Git.
# The extraction server (server/) does not read this file: its Anthropic key lives in
# server/.dev.vars locally and in `npx wrangler secret put ANTHROPIC_API_KEY` in production.
ROUTES_API_KEY=
PLACES_API_KEY=
RENTAL_DATA_API_KEY=
LLM_API_KEY=
