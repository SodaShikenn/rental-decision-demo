{$RENTAL_DOMAIN} {
	encode zstd gzip
	@api path /api/* /healthz /docs /openapi.json
	handle @api {
		reverse_proxy api:8000 {
			transport http {
				response_header_timeout 200s
			}
		}
	}
	@private path /tests/* /.git/* /.env*
	handle @private {
		respond 404
	}
	handle {
		root * /srv
		file_server
	}
}
