{
  "name": "rental-helper",
  "private": true,
  "description": "Rental Helper: compare rental candidates with sourced facts, discover priorities through interactive AI advice, and create a tenant decision brief.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "python3 -m http.server 4173 --bind 127.0.0.1 --directory web",
    "dev:server": "cd server && .venv/bin/uvicorn app:create_app --factory --reload --port 8000",
    "test": "npm run test:web && npm run test:server",
    "test:web": "node --test \"web/tests/**/*.test.js\"",
    "test:server": "cd server && .venv/bin/python -m pytest",
    "smoke": "cd server && .venv/bin/python -m commands.smoke",
    "record:sheets": "cd server && .venv/bin/python -m commands.record_sheets",
    "up": "docker compose -f docker/docker-compose.yml up --build",
    "down": "docker compose -f docker/docker-compose.yml down"
  }
}
