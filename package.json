{
  "name": "rental-helper",
  "private": true,
  "description": "Rental Helper: compare rental candidates with sourced facts, discover priorities through interactive AI advice, and create a tenant decision brief.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "python3 -m http.server 4173 --bind 127.0.0.1 --directory web",
    "dev:server": "cd server && .venv/bin/uvicorn app:create_app --factory --reload --port 8000",
    "test": "npm run test:web && npm run test:server",
    "test:web": "node --test \"web/tests/**/*.test.js\"",
    "test:server": "cd server && .venv/bin/python -m pytest",
    "smoke": "cd server && .venv/bin/python -m commands.smoke",
    "record:sheets": "cd server && .venv/bin/python -m commands.record_sheets",
    "up": "docker compose -f docker/docker-compose.yml up --build",
    "down": "docker compose -f docker/docker-compose.yml down",
    "format": "prettier --write \"web/apps/{commute,leisure,scenarios,reviews,sharing}/**/*.js\" \"web/shared/*.js\" \"web/tests/apps/{commute,leisure,scenarios,reviews,sharing}/**/*.js\" \"web/static/{features,workspace,interactions,navigation}.css\" \"web/share.html\" \"scripts/*.mjs\" \"web/tests/deployment/*.js\" \"scripts/browser*-smoke.js\" \"web/apps/workspace/{index,navigation,navigation-views}.js\" \"scripts/browser-demo-*.js\" \"web/demo/*.js\" \"web/demo/*.css\" \"web/demo/*.html\"",
    "format:check": "prettier --check \"web/apps/{commute,leisure,scenarios,reviews,sharing}/**/*.js\" \"web/shared/*.js\" \"web/tests/apps/{commute,leisure,scenarios,reviews,sharing}/**/*.js\" \"web/static/{features,workspace,interactions,navigation}.css\" \"web/share.html\" \"scripts/*.mjs\" \"web/tests/deployment/*.js\" \"scripts/browser*-smoke.js\" \"web/apps/workspace/{index,navigation,navigation-views}.js\" \"scripts/browser-demo-*.js\" \"web/demo/*.js\" \"web/demo/*.css\" \"web/demo/*.html\"",
    "smoke:browser": "node scripts/run-browser-smoke.mjs",
    "smoke:ui": "node scripts/run-browser-smoke.mjs --ui",
    "record:demo": "node scripts/record-demo.mjs",
    "smoke:demo": "node scripts/run-browser-smoke.mjs --demo",
    "dev:demo": "npx --yes http-server@14.1.1 web -p 4174 -a 127.0.0.1 -c-1"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
