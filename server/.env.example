# Copy to server/.env for local runs (uvicorn or docker compose). Never commit .env.
# mock: return the fixture reading without OCR or Gemini (no key, no cost).
# live: OCR runs inside the server (Docling); the recognized text is sent to Gemini to map fields.
EXTRACTION_MODE=mock

# Google AI Studio key for the Gemini API. Use a paid-tier project in production: on the free tier,
# Google may use submitted content to improve its products.
GEMINI_API_KEY=

# Optional (defaults shown)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low          # minimal | low | medium | high
# EXTRACTION_ENABLED=true
# RATE_LIMIT_PER_MINUTE=5
# ALLOWED_ORIGINS=https://sodashikenn.github.io,http://localhost:4173,http://127.0.0.1:4173

# Reserved for upcoming server-side Google Maps Platform integrations (Routes, Places, Geocoding)
# GOOGLE_MAPS_API_KEY=
